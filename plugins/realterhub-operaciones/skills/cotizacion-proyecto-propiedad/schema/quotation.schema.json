{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realterhub.com/schemas/real-estate-quotation-v1.json",
  "title": "RealterHub real estate quotation",
  "type": "object",
  "required": ["schemaVersion", "document", "organization", "collaborator", "contact", "quotationType", "paymentConfiguration"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "document": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "locale": { "type": "string", "default": "es-DO" },
        "title": { "type": "string", "default": "Cotización" }
      },
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "logoUrl": { "type": ["string", "null"] } },
      "additionalProperties": false
    },
    "collaborator": {
      "type": "object",
      "required": ["fullName"],
      "properties": { "fullName": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "contact": { "$ref": "#/$defs/contact" },
    "quotationType": { "enum": ["projectUnit", "readyProperty"] },
    "project": { "$ref": "#/$defs/project" },
    "projectUnit": { "$ref": "#/$defs/projectUnit" },
    "projectPaymentPlan": { "$ref": "#/$defs/projectPaymentPlan" },
    "property": { "$ref": "#/$defs/property" },
    "propertyOffering": { "$ref": "#/$defs/propertyOffering" },
    "paymentConfiguration": { "$ref": "#/$defs/paymentConfiguration" },
    "notes": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "quotationType": { "const": "projectUnit" } } },
      "then": { "required": ["project", "projectUnit", "projectPaymentPlan"] }
    },
    {
      "if": { "properties": { "quotationType": { "const": "readyProperty" } } },
      "then": { "required": ["property", "propertyOffering"] }
    }
  ],
  "$defs": {
    "identity": { "type": "string", "format": "uuid" },
    "money": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?$" },
    "contact": {
      "type": "object",
      "required": ["id", "fullName"],
      "properties": { "id": { "$ref": "#/$defs/identity" }, "fullName": { "type": "string" }, "email": { "type": ["string", "null"] }, "phone": { "type": ["string", "null"] } },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "currency", "estimatedHandoverDate"],
      "properties": { "id": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "code": { "type": ["string", "null"] }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "estimatedHandoverDate": { "type": "string", "format": "date" }, "featuredImageUrl": { "type": ["string", "null"] } },
      "additionalProperties": false
    },
    "projectUnit": {
      "type": "object",
      "required": ["id", "code", "basePrice"],
      "properties": { "id": { "$ref": "#/$defs/identity" }, "code": { "type": "string" }, "basePrice": { "$ref": "#/$defs/money" }, "status": { "type": ["string", "null"] }, "unitType": { "type": ["string", "null"] }, "totalArea": { "type": ["string", "number", "null"] }, "measurementUnit": { "type": ["string", "null"] } },
      "additionalProperties": false
    },
    "projectPaymentPlan": {
      "type": "object",
      "required": ["id", "name", "currency", "status", "installments"],
      "properties": { "id": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "description": { "type": ["string", "null"] }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "status": { "const": "active" }, "installments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/installment" } } },
      "additionalProperties": false
    },
    "installment": {
      "type": "object",
      "required": ["position", "milestoneType", "amountType", "amountValue"],
      "properties": { "position": { "type": "integer", "minimum": 1 }, "milestoneType": { "enum": ["reservation", "promissoryAgreement", "contractSigning", "constructionPayment", "closing", "postDelivery", "other"] }, "amountType": { "enum": ["percentage", "fixed"] }, "amountValue": { "$ref": "#/$defs/money" } },
      "additionalProperties": false
    },
    "propertyRef": {
      "type": ["object", "null"],
      "properties": { "id": { "$ref": "#/$defs/identity" }, "name": { "type": "string" } },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "required": ["id", "name", "code"],
      "properties": { "id": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "code": { "type": "string" }, "propertyType": { "type": ["string", "null"] }, "propertySubtype": { "type": ["string", "null"] }, "areas": { "type": ["string", "null"] }, "availability": { "type": ["string", "null"] }, "sectorName": { "type": ["string", "null"] }, "addressLine1": { "type": ["string", "null"] }, "city": { "$ref": "#/$defs/propertyRef" }, "state": { "$ref": "#/$defs/propertyRef" }, "featuredImage": { "type": ["object", "null"], "properties": { "id": { "$ref": "#/$defs/identity" }, "publicUrl": { "type": "string" } }, "required": ["id", "publicUrl"], "additionalProperties": true } },
      "additionalProperties": false
    },
    "propertyOffering": {
      "type": "object",
      "required": ["id", "offeringType", "status", "price", "currency", "isNegotiable"],
      "properties": { "id": { "$ref": "#/$defs/identity" }, "offeringType": { "const": "sale" }, "status": { "const": "active" }, "price": { "$ref": "#/$defs/money" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "isNegotiable": { "type": "boolean" } },
      "additionalProperties": false
    },
    "paymentConfiguration": {
      "type": "object",
      "required": ["reservationApplication", "constructionMethod"],
      "properties": {
        "reservationApplication": { "enum": ["creditAgainstSigning", "standalone"] },
        "constructionMethod": { "const": "monthlyUntilTarget" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "reservationAmount": { "$ref": "#/$defs/money" },
        "signingPercentage": { "$ref": "#/$defs/money" },
        "constructionPercentage": { "$ref": "#/$defs/money" },
        "closingPercentage": { "$ref": "#/$defs/money" },
        "targetDate": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
